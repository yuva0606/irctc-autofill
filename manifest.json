{
  "manifest_version": 3,
  "name": "IRCTC Autofill",
  "version": "0.1.0",
  "description": "Local IRCTC passenger autofill extension",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/*"
      ],
      "js": [
        "selectors.js",
        "content.js"
      ]
    }
  ]
}